}

//go:embed app.ico.b64
var appIconBase64 string

var appIconICO = func() []byte { b, _ := base64.StdEncoding.DecodeString(strings.TrimSpace(appIconBase64)); return b }()

var (
	hIconLarge uintptr
	hIconSmall uintptr
	state      = &appState{topmost: true, visible: true, opacity: 255}
	hwndMain   uintptr
	hwndEdit   uintptr
	hwndSave   uintptr
	hwndPin    uintptr
	fetching   atomic.Bool
	httpClient = &http.Client{Timeout: 15 * time.Second}
	fontTitle  uintptr
	fontNormal uintptr
	fontSmall  uintptr
)

func utf16Ptr(s string) *uint16 { p, _ := syscall.UTF16PtrFromString(s); return p }
func loWord(v uintptr) uint16   { return uint16(v & 0xffff) }
func rgb(r, g, b byte) uintptr  { return uintptr(uint32(r) | uint32(g)<<8 | uint32(b)<<16) }

func clientCursor() point {
	var pt point
	procGetCursorPos.Call(uintptr(unsafe.Pointer(&pt)))
	procScreenToClient.Call(hwndMain, uintptr(unsafe.Pointer(&pt)))
	return pt
}

func pinRect() rect { return rect{304, 8, 334, 38} }

func pointInRect(pt point, r rect) bool {
	return pt.X >= r.Left && pt.X < r.Right && pt.Y >= r.Top && pt.Y < r.Bottom
}

func setOpacity(alpha byte) {
	if alpha < 40 {
		alpha = 40
	}
	procSetLayeredWindowAttributes.Call(hwndMain, 0, uintptr(alpha), LWA_ALPHA)
	state.mu.Lock()
	state.opacity = alpha
	state.mu.Unlock()
}

func positionPinWindow() {
	if hwndPin == 0 || hwndMain == 0 {
		return
	}
	var wr rect
	if r, _, _ := procGetWindowRect.Call(hwndMain, uintptr(unsafe.Pointer(&wr))); r == 0 {
		return
	}
	procSetWindowPos.Call(hwndPin, HWND_TOPMOST, uintptr(wr.Right-36), uintptr(wr.Top+8), 28, 28, 0)
}

func setLocked(on bool) {
	if hwndMain == 0 {
		return
	}
	ex, _, _ := procGetWindowLongPtrW.Call(hwndMain, ^uintptr(19))
	if on {
		ex |= WS_EX_TRANSPARENT
	} else {
		ex &^= WS_EX_TRANSPARENT
	}
	procSetWindowLongPtrW.Call(hwndMain, ^uintptr(19), ex)
	state.mu.Lock()
	state.locked = on
	visible := state.visible
	state.mu.Unlock()
	if hwndPin != 0 {
		if on && visible {
			positionPinWindow()
			procShowWindow.Call(hwndPin, SW_SHOW)
		} else {
			procShowWindow.Call(hwndPin, SW_HIDE)
		}
	}
	procInvalidateRect.Call(hwndMain, 0, 1)
}

func configPath() (string, error) {
	base := os.Getenv("APPDATA")
	if base == "" {
		return "", errors.New("APPDATA not found")
	}
	dir := filepath.Join(base, "OpenCodeGoUsage")
	if err := os.MkdirAll(dir, 0700); err != nil {
		return "", err
	}
	return filepath.Join(dir, "key.dat"), nil
}

func entropyBlob() dataBlob {
	sum := sha256.Sum256([]byte("OpenCodeGoUsageFloat/v1/local-key"))
	return dataBlob{CbData: uint32(len(sum)), PbData: &sum[0]}
}

func protect(data []byte) ([]byte, error) {
	if len(data) == 0 {
		return nil, nil
	}
	in := dataBlob{CbData: uint32(len(data)), PbData: &data[0]}
	ent := entropyBlob()
	var out dataBlob
	r, _, e := procCryptProtectData.Call(uintptr(unsafe.Pointer(&in)), 0, uintptr(unsafe.Pointer(&ent)), 0, 0, 0x1, uintptr(unsafe.Pointer(&out)))
	if r == 0 {
		return nil, e
	}
	defer procLocalFree.Call(uintptr(unsafe.Pointer(out.PbData)))
	return append([]byte(nil), unsafe.Slice(out.PbData, out.CbData)...), nil
}

func unprotect(data []byte) ([]byte, error) {
	if len(data) == 0 {
		return nil, nil
	}
	in := dataBlob{CbData: uint32(len(data)), PbData: &data[0]}
	ent := entropyBlob()
	var out dataBlob
	r, _, e := procCryptUnprotectData.Call(uintptr(unsafe.Pointer(&in)), 0, uintptr(unsafe.Pointer(&ent)), 0, 0, 0x1, uintptr(unsafe.Pointer(&out)))
	if r == 0 {
		return nil, e
	}
	defer procLocalFree.Call(uintptr(unsafe.Pointer(out.PbData)))
	return append([]byte(nil), unsafe.Slice(out.PbData, out.CbData)...), nil
}

func saveKey(key string) error {
	p, err := configPath()
	if err != nil {
		return err
	}
	enc, err := protect([]byte(key))
	if err != nil {
		return err
	}
	var buf bytes.Buffer
	buf.WriteString("OCGU1")
	_ = binary.Write(&buf, binary.LittleEndian, uint32(len(enc)))
	buf.Write(enc)
	return os.WriteFile(p, buf.Bytes(), 0600)
}

func loadKey() string {
	p, err := configPath()
	if err != nil {
		return ""
	}
	raw, err := os.ReadFile(p)
	if err != nil || len(raw) < 9 || string(raw[:5]) != "OCGU1" {
		return ""
	}
	n := binary.LittleEndian.Uint32(raw[5:9])
	if int(9+n) > len(raw) {
		return ""
	}
