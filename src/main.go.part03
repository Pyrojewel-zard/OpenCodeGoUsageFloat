		if getText(hwndEdit) == "" && key != "" {
			setText(hwndEdit, key)
		}
		procSetFocus.Call(hwndEdit)
	} else {
		procShowWindow.Call(hwndEdit, SW_HIDE)
		procShowWindow.Call(hwndSave, SW_HIDE)
		setText(hwndEdit, "")
	}
	procInvalidateRect.Call(hwndMain, 0, 1)
}

func setTopmost(on bool) {
	target := HWND_NOTOPMOST
	if on {
		target = HWND_TOPMOST
	}
	procSetWindowPos.Call(hwndMain, target, 0, 0, 0, 0, SWP_NOMOVE|SWP_NOSIZE)
	if hwndPin != 0 {
		procSetWindowPos.Call(hwndPin, target, 0, 0, 0, 0, SWP_NOMOVE|SWP_NOSIZE)
	}
	state.mu.Lock()
	state.topmost = on
	state.mu.Unlock()
}

func showTrayMenu() {
	menu, _, _ := procCreatePopupMenu.Call()
	if menu == 0 {
		return
	}
	defer procDestroyMenu.Call(menu)
	state.mu.RLock()
	top := state.topmost
	visible := state.visible
	light := state.lightMode
	locked := state.locked
	opacity := state.opacity
	state.mu.RUnlock()
	appendMenu := func(flags uintptr, id uintptr, text string) {
		procAppendMenuW.Call(menu, flags, id, uintptr(unsafe.Pointer(utf16Ptr(text))))
	}
	if visible {
		appendMenu(MF_STRING, menuShow, "隐藏浮窗")
	} else {
		appendMenu(MF_STRING, menuShow, "显示浮窗")
	}
	appendMenu(MF_STRING, menuRefresh, "立即刷新")
	appendMenu(MF_STRING, menuSetup, "修改 API Key")
	themeFlag := uintptr(MF_STRING | MF_UNCHECKED)
	if light {
		themeFlag = MF_STRING | MF_CHECKED
	}
	appendMenu(themeFlag, menuTheme, "白色模式")
	pinFlag := uintptr(MF_STRING | MF_UNCHECKED)
	if locked {
		pinFlag = MF_STRING | MF_CHECKED
	}
	appendMenu(pinFlag, menuPin, "Pin 锁定 / 鼠标穿透")
	appendMenu(MF_SEPARATOR, 0, "")
	appendMenu(MF_STRING|map[bool]uintptr{true: MF_CHECKED, false: MF_UNCHECKED}[opacity == 255], menuOpacity100, "透明度 100%")
	appendMenu(MF_STRING|map[bool]uintptr{true: MF_CHECKED, false: MF_UNCHECKED}[opacity == 217], menuOpacity85, "透明度 85%")
	appendMenu(MF_STRING|map[bool]uintptr{true: MF_CHECKED, false: MF_UNCHECKED}[opacity == 179], menuOpacity70, "透明度 70%")
	appendMenu(MF_STRING|map[bool]uintptr{true: MF_CHECKED, false: MF_UNCHECKED}[opacity == 140], menuOpacity55, "透明度 55%")
	topFlag := uintptr(MF_STRING | MF_UNCHECKED)
	if top {
		topFlag = MF_STRING | MF_CHECKED
	}
	appendMenu(topFlag, menuTopmost, "始终置顶")
	appendMenu(MF_SEPARATOR, 0, "")
	appendMenu(MF_STRING, menuExit, "退出")
	var pt point
	procGetCursorPos.Call(uintptr(unsafe.Pointer(&pt)))
	procSetForegroundWindow.Call(hwndMain)
	cmd, _, _ := procTrackPopupMenu.Call(menu, TPM_RIGHTBUTTON|TPM_RETURNCMD, uintptr(pt.X), uintptr(pt.Y), 0, hwndMain, 0)
	if cmd != 0 {
		procPostMessageW.Call(hwndMain, WM_COMMAND, cmd, 0)
	}
}

func loadEmbeddedIcon(desired int) uintptr {
	// ICO header: ICONDIR (6 bytes), followed by 16-byte ICONDIRENTRY records.
	// CreateIconFromResourceEx accepts the raw image payload from one entry.
	if len(appIconICO) < 6 || binary.LittleEndian.Uint16(appIconICO[0:2]) != 0 || binary.LittleEndian.Uint16(appIconICO[2:4]) != 1 {
		return 0
	}
	count := int(binary.LittleEndian.Uint16(appIconICO[4:6]))
	bestOffset, bestSize, bestDelta := 0, 0, int(^uint(0)>>1)
	for i := 0; i < count; i++ {
		base := 6 + i*16
		if base+16 > len(appIconICO) {
			break
		}
		w := int(appIconICO[base])
		if w == 0 {
			w = 256
		}
		h := int(appIconICO[base+1])
		if h == 0 {
			h = 256
		}
		sz := int(binary.LittleEndian.Uint32(appIconICO[base+8 : base+12]))
		off := int(binary.LittleEndian.Uint32(appIconICO[base+12 : base+16]))
		if sz <= 0 || off < 0 || off+sz > len(appIconICO) {
			continue
		}
		delta := w - desired
		if delta < 0 {
			delta = -delta
		}
		if hdelta := h - desired; hdelta < 0 {
			delta += -hdelta
		} else {
			delta += hdelta
		}
		if delta < bestDelta {
			bestDelta, bestOffset, bestSize = delta, off, sz
		}
	}
	if bestSize == 0 {
		return 0
	}
	h, _, _ := procCreateIconFromResourceEx.Call(
		uintptr(unsafe.Pointer(&appIconICO[bestOffset])), uintptr(bestSize), 1, 0x00030000,
		uintptr(desired), uintptr(desired), 0,
	)
	return h
}

func addTrayIcon() {
	icon := hIconSmall
	if icon == 0 {
		icon, _, _ = procLoadIconW.Call(0, IDI_APPLICATION)
	}
	var nid notifyIconData
	nid.CbSize = uint32(unsafe.Sizeof(nid))
	nid.HWnd = hwndMain
	nid.UID = 1
	nid.UFlags = NIF_MESSAGE | NIF_ICON | NIF_TIP
	nid.UCallbackMessage = WM_TRAYICON
	nid.HIcon = icon
	tip, _ := syscall.UTF16FromString("OpenCode Go Usage")
	copy(nid.SzTip[:], tip)
	procShellNotifyIconW.Call(NIM_ADD, uintptr(unsafe.Pointer(&nid)))
}
func removeTrayIcon() {
	var nid notifyIconData
	nid.CbSize = uint32(unsafe.Sizeof(nid))
	nid.HWnd = hwndMain
	nid.UID = 1
	procShellNotifyIconW.Call(NIM_DELETE, uintptr(unsafe.Pointer(&nid)))
}

func wndProc(hwnd uintptr, message uint32, wParam, lParam uintptr) uintptr {
	switch message {
	case WM_PAINT:
		paint(hwnd)
		return 0
	case WM_NCHITTEST:
		state.mu.RLock()
		setup := state.setup || state.key == ""
		locked := state.locked
		state.mu.RUnlock()
		pt := clientCursor()
		if pointInRect(pt, pinRect()) {
			return HTCLIENT
		}
		if locked {
			return HTTRANSPARENT
		}
		if setup {
			return HTCLIENT
		}
		return HTCAPTION
	case WM_LBUTTONDOWN:
		pt := point{X: int32(int16(loWord(lParam))), Y: int32(int16(loWord(lParam >> 16)))}
		if pointInRect(pt, pinRect()) {
			state.mu.RLock()
			next := !state.locked
			state.mu.RUnlock()
			setLocked(next)
			return 0
		}
	case WM_TIMER:
		if wParam == 1 {
			procInvalidateRect.Call(hwnd, 0, 0)
		}
		if wParam == 2 {
			go fetchUsage()
		}
		return 0
	case WM_DATAREADY:
		procInvalidateRect.Call(hwnd, 0, 1)
		return 0
	case WM_SHOWSETUP:
		state.mu.Lock()
		state.setup = true
		state.mu.Unlock()
		updateSetupControls()
		return 0
	case WM_COMMAND:
		id := int(loWord(wParam))
		switch id {
		case idUnlock:
			setLocked(false)
			return 0
		case idSaveKey:
			k := strings.TrimSpace(getText(hwndEdit))
			if k == "" {
				return 0
			}
			if err := saveKey(k); err != nil {
				state.mu.Lock()
				state.errText = "保存 Key 失败"
				state.mu.Unlock()
				procInvalidateRect.Call(hwnd, 0, 1)
				return 0
			}
			state.mu.Lock()
			state.key = k
			state.setup = false
			state.errText = ""
			state.mu.Unlock()
			updateSetupControls()
			go fetchUsage()
			return 0
		case menuRefresh:
			go fetchUsage()
			return 0
		case menuSetup:
			procPostMessageW.Call(hwnd, WM_SHOWSETUP, 0, 0)
			return 0
		case menuTopmost:
			state.mu.RLock()
			on := !state.topmost
			state.mu.RUnlock()
			setTopmost(on)
			return 0
		case menuTheme:
			state.mu.Lock()
			state.lightMode = !state.lightMode
			state.mu.Unlock()
			procInvalidateRect.Call(hwnd, 0, 1)
			return 0
		case menuPin:
			state.mu.RLock()
			next := !state.locked
			state.mu.RUnlock()
			setLocked(next)
			return 0
		case menuOpacity100:
			setOpacity(255)
			return 0
		case menuOpacity85:
			setOpacity(217)
			return 0
		case menuOpacity70:
			setOpacity(179)
			return 0
		case menuOpacity55:
			setOpacity(140)
			return 0
		case menuShow:
			state.mu.Lock()
			state.visible = !state.visible
			visible := state.visible
			state.mu.Unlock()
			if visible {
				procShowWindow.Call(hwnd, SW_SHOW)
				state.mu.RLock()
				lk := state.locked
				state.mu.RUnlock()
				if lk {
					positionPinWindow()
					procShowWindow.Call(hwndPin, SW_SHOW)
				}
			} else {
				procShowWindow.Call(hwnd, SW_HIDE)
